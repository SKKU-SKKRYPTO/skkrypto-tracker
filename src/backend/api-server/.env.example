# API 서버가 읽는 환경 변수와 기본값. 비밀값은 없다.
# - docker compose: 같은 폴더의 .env를 읽는다(cp .env.example .env 뒤 고친다). API_ADDR·FIXTURE_DIR는 compose가 고정한다.
# - make run-api: .env를 읽지 않는다. 바꿀 값을 앞에 붙인다. 예: API_ADDR=:9090 make run-api
# - 배포(Railway 등): 서비스의 환경 변수로 넣는다.
# .env는 루트 .gitignore가 커밋을 막는다.

# 서버 주소(포트)
API_ADDR=:8080
# 클라이언트 IP마다 1분에 받는 요청 수(0이면 제한 없음).
# 도커 포트 연결이나 프록시 뒤에서는 모든 사용자가 같은 IP로 보여 한도를 함께 쓴다.
# 실습처럼 여러 명이 한 서버를 쓰면 값을 올리거나 0으로 둔다.
RATE_LIMIT_PER_MINUTE=120
# 브라우저에서 API를 부를 수 있는 웹 주소. 쉼표로 여러 개(웹 개발 서버, Swagger UI).
# 브라우저에 친 주소 그대로 적는다(localhost와 127.0.0.1은 다른 주소로 본다).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Fixture 폴더. 기본값은 api-server/testdata/fixtures(Go 모듈 루트 src/backend 기준), 도커 이미지 안에서는 /app/fixtures
# FIXTURE_DIR=api-server/testdata/fixtures
# PostgreSQL 접속 주소. 넣으면 Fixture 대신 DB를 읽고, 비우면 Fixture를 읽는다.
# 비밀번호가 들어가므로 .env나 배포 환경 변수에만 넣는다. Railway에서는 ${{Postgres.DATABASE_URL}}(내부 주소)를 참조한다.
# DATABASE_URL=postgres://ex_admin:ex_password@127.0.0.1:5432/ex_postgres?sslmode=disable
