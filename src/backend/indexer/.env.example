## Indexer는 .env 파일을 자동으로 읽지 않습니다.
## 실행 환경에서 아래 이름을 설정하세요. 실제 URL·키·비밀번호는 커밋하지 않습니다.
RPC_URL=
## Docker Compose로 실행하면 DB 주소는 postgres:5432입니다(값은 src/database/.env와 같게).
## 예: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?sslmode=disable
DATABASE_URL=

## Docker Compose의 indexer 서비스가 아래 값을 collect CLI 인자로 전달합니다.
INDEXER_DATASET_ID=
INDEXER_DATASET_VERSION=
INDEXER_NAMESPACE=
INDEXER_TOKEN=
INDEXER_START_BLOCK=
INDEXER_END_BLOCK=
