# Leave empty to use relative /api requests and the Vite local Go API proxy.
# Set the server base URL WITHOUT /api; services already include /api in request paths.
# VITE_ variables are public browser configuration. Never put secrets here.
VITE_API_BASE_URL=

# Practice tab (optional). Problems load from practice/problems.json next to the built page by default.
# Answers are never configured in the web; grading uses POST /api/practice/grade.
# VITE_PRACTICE_PROBLEMS_URL=
# VITE_PRACTICE_SUBMIT_URL=
